<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>BeaversTests.Client</PackageId>
        <PackageVersion>0.0.1</PackageVersion>
        <Authors>BeaversTests</Authors>
        <Description>HTTP client library for BeaversTests API</Description>
<!--        <PackageLicenseExpression>MIT</PackageLicenseExpression>-->
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Http" />
      <PackageReference Include="Microsoft.Extensions.Http.Polly" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
      <PackageReference Include="Microsoft.Extensions.Options" />
      <PackageReference Include="Newtonsoft.Json" />
      <PackageReference Include="Polly" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Blocks\Auth\BeaversTests.Auth.Public\BeaversTests.Auth.Public.csproj" />
      <ProjectReference Include="..\..\Blocks\Core\BeaversTests.Platform.Public\BeaversTests.Platform.Public.csproj" />
    </ItemGroup>

</Project>
